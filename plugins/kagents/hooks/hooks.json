{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/secret-scanner.ps1\"",
            "windows": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/secret-scanner.ps1\"",
            "linux": "pwsh -NoProfile -File '${CLAUDE_PLUGIN_ROOT}/hooks/secret-scanner.ps1'",
            "osx": "pwsh -NoProfile -File '${CLAUDE_PLUGIN_ROOT}/hooks/secret-scanner.ps1'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/destructive-command-guard.ps1\"",
            "windows": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/destructive-command-guard.ps1\"",
            "linux": "pwsh -NoProfile -File '${CLAUDE_PLUGIN_ROOT}/hooks/destructive-command-guard.ps1'",
            "osx": "pwsh -NoProfile -File '${CLAUDE_PLUGIN_ROOT}/hooks/destructive-command-guard.ps1'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/releaseflow-guardrail.ps1\"",
            "windows": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/releaseflow-guardrail.ps1\"",
            "linux": "pwsh -NoProfile -File '${CLAUDE_PLUGIN_ROOT}/hooks/releaseflow-guardrail.ps1'",
            "osx": "pwsh -NoProfile -File '${CLAUDE_PLUGIN_ROOT}/hooks/releaseflow-guardrail.ps1'"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/crossplatform-lint-guard.ps1\"",
            "windows": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/crossplatform-lint-guard.ps1\"",
            "linux": "pwsh -NoProfile -File '${CLAUDE_PLUGIN_ROOT}/hooks/crossplatform-lint-guard.ps1'",
            "osx": "pwsh -NoProfile -File '${CLAUDE_PLUGIN_ROOT}/hooks/crossplatform-lint-guard.ps1'"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_call.ps1\"",
            "windows": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_call.ps1\"",
            "linux": "pwsh -NoProfile -File '${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_call.ps1'",
            "osx": "pwsh -NoProfile -File '${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_call.ps1'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/post_tool_call.ps1\"",
            "windows": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/post_tool_call.ps1\"",
            "linux": "pwsh -NoProfile -File '${CLAUDE_PLUGIN_ROOT}/hooks/post_tool_call.ps1'",
            "osx": "pwsh -NoProfile -File '${CLAUDE_PLUGIN_ROOT}/hooks/post_tool_call.ps1'"
          }
        ]
      }
    ]
  }
}
