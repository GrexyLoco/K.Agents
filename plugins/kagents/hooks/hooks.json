{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "pwsh",
            "command": "& \"$env:CLAUDE_PLUGIN_ROOT/hooks/releaseflow-guardrail.ps1\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "pwsh",
            "command": "& \"$env:CLAUDE_PLUGIN_ROOT/hooks/pre_tool_call.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "pwsh",
            "command": "& \"$env:CLAUDE_PLUGIN_ROOT/hooks/post_tool_call.ps1\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "pwsh",
            "command": "& \"$env:CLAUDE_PLUGIN_ROOT/hooks/on_error.ps1\""
          }
        ]
      }
    ]
  }
}
